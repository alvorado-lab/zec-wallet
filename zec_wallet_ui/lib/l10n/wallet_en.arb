    "description": "Screen-reader label and tooltip of the eye button in the wallet header while amounts are SHOWN: pressing it replaces every amount with dots (FR-49 W-7; maintainer FD-6)."
  },
  "walletShowBalance": "Show balance",
  "@walletShowBalance": {
    "description": "Screen-reader label and tooltip of the eye button while amounts are HIDDEN: pressing it shows them again (FR-49 W-7; maintainer FD-6)."
  },
  "walletBalanceHiddenAmount": "Balance hidden",
  "@walletBalanceHiddenAmount": {
    "description": "What a screen reader says in place of an amount the user has hidden with the eye button (the screen shows dots)."
