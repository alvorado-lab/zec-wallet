  },
  "walletSendAnother": "Send another",
  "@walletSendAnother": {
    "description": "Return to a fresh form after a completed send."
  },
  "walletSendQueuedTitle": "Queued to send",
  "@walletSendQueuedTitle": {
    "description": "Result: the offline send intent was durably stored."
  },
  "walletSendQueuedBody": "This payment is saved. You'll find it under Saved & pending, where you can send it now or cancel it.",
  "@walletSendQueuedBody": {
    "description": "Result body for a queued (offline-first) send. It must be true at EVERY custody tier (#400 R9): the previous 'we'll send this automatically the next time your wallet syncs online' is FALSE wherever the wallet holds no signing credential of its own — a host that authorizes each spend individually cannot sign on an unattended background pass at all, and that is exactly the host the offline queue was widened for (FR-23-b). So promise no schedule; name the surface the payment now lives on (keep the wording in step with walletParkedTitle) and the two things the user can actually do there. Never 'as soon as you're online' (the retry schedule can lag a reconnect), and never anything that invites re-entering the payment (a double pay)."
  },
  "walletSendFaultInsufficient": "Not enough spendable balance — you have {available} ZEC and this needs {required} ZEC.",
  "@walletSendFaultInsufficient": {
    "description": "Form fault: insufficient funds. Figures are integer-formatted; never logged (§5.4).",
