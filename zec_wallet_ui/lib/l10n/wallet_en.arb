  "walletSendSavedBody": "Your payment couldn't go out just now, so it's saved and your wallet will send it on a later sync. Nothing is lost.",
  "@walletSendSavedBody": {
    "description": "Result body when no transaction was accepted this attempt — cause-agnostic: a transport miss OR a mempool reject (which can be the already-known race shape with money actually in motion; the wallet-screen in-flight cue owns that window). Money-safe; auto-retry. The automatic promise is TRUE at every custody tier (#401 R1b): this transaction is already SIGNED, and the §6.1 ReBroadcast arm re-sends the raw bytes with no seed — unlike a QUEUED intent, which needs a credential the background pass may not have. It is PASS-dependent though, so the render site appends walletSyncPausedMoneyNote when no pass will run. 'On a later sync' — never 'as soon as you're online' (the #399 reconnect-promptness rule)."
  },
  "walletSendKeptTitle": "Saved",
  "@walletSendKeptTitle": {
    "description": "Result: a transaction was signed and kept, but the wallet did NOT report that it will retry it on its own (stage S8 obligation, row 10 — the core's per-transaction delivery state was not retry-pending, or could not be read). No promise of automatic sending; Activity shows the live state. Shared by the send, shield and move result surfaces."
  },
  "walletSendKeptBody": "Your wallet has kept this transaction and hasn't promised to send it by itself. Check Activity to see where it stands.",
  "@walletSendKeptBody": {
    "description": "Result body for walletSendKeptTitle. Deliberately makes NO claim either way about automatic sending: it is shown both when the wallet reported a held state (a swap deposit past its quote) and when the reading could not be taken, and must be true in both. Points at Activity, where TxSummary.delivery is rendered."
  },
  "walletSendPartialBody": "Part of your payment went out; your wallet will complete the rest on a later sync. Nothing is lost.",
  "@walletSendPartialBody": {
    "description": "Result body when some (not all) pool-crossing transactions broadcast. Same #401 R1b posture as walletSendSavedBody: already signed, so the completion promise holds at every custody tier, and the render site appends walletSyncPausedMoneyNote when no sync pass will run."
  },
  "walletSendInMotionTitle": "Payment in progress",
  "@walletSendInMotionTitle": {
    "description": "Result title for a TEX two-step send with some but not all legs accepted (either order) — funds are in motion on a wallet-controlled one-time address."
  },
  "walletSendInMotionBody": "Your payment has started and is moving through a one-time address your wallet controls. Don't send it again. If it doesn't finish, you can recover the funds from your wallet screen.",
  "@walletSendInMotionBody": {
    "description": "Honest in-motion body for a partial TEX two-step send. Must NOT promise auto-completion (the forwarding step can expire into a recoverable strand); only the permanently-true 'don't re-send' plus pointing at the shipped wallet-screen recovery."
  },
  "walletSendAlreadyTitle": "Already submitted",
  "@walletSendAlreadyTitle": {
    "description": "Result: the one-shot proposal was already consumed (double-tap)."
  },
  "walletSendAlreadyBody": "This payment was already submitted — it won't be sent twice.",
  "@walletSendAlreadyBody": {
