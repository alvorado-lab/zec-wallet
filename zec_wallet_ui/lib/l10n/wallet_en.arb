  "walletSendFailedBody": "Something went wrong completing this payment and nothing was sent. You can try again.",
  "@walletSendFailedBody": {
    "description": "Result body for a sign/build failure (re-propose needed)."
  },
  "walletSendTryAgain": "Try again",
  "@walletSendTryAgain": {
