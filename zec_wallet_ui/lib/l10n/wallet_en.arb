        "type": "String"
      }
    }
  },
  "walletSpendableLabel": "Spendable now",
  "@walletSpendableLabel": {
    "description": "Label for the confirmed, spendable portion of the balance."
  },
  "walletArrivingLabel": "Arriving",
  "@walletArrivingLabel": {
    "description": "New incoming money that is not yet confirmed. Used in two places: the synced balance card's foot, shown OUTSIDE the balance with a '+' before the amount (maintainer: 'show the actual amount that we have now and pending is a separate part'), and the status of an incoming activity row that is not yet mined. Never for money the user already has."
  },
  "walletNotSpendableYetLabel": "Not spendable yet",
  "@walletNotSpendableYetLabel": {
    "description": "Balance card breakdown row while the wallet is NOT synced: money the user already has, inside the balance, that cannot be spent until the sync finishes (the wallet cannot yet build what spending it needs). Not new or incoming money — never translate as 'arriving' or 'incoming'."
  },
  "walletActivityTitle": "Activity",
  "@walletActivityTitle": {
    "description": "Heading above the transaction-history list on the wallet screen."
  },
  "walletActivityEmpty": "No activity yet",
  "@walletActivityEmpty": {
    "description": "Empty-state line when the wallet has no transaction history."
  },
  "walletActivityError": "Couldn't load activity",
  "@walletActivityError": {
    "description": "Honest error line when the transaction-history read fails or times out."
  },
  "walletActivityReceived": "Received",
  "@walletActivityReceived": {
    "description": "Title of an incoming (positive net amount) history row."
  },
  "walletActivitySent": "Sent",
  "@walletActivitySent": {
    "description": "Title of an outgoing (negative net amount) history row."
  },
  "walletActivityPending": "Pending",
  "@walletActivityPending": {
    "description": "Status of a broadcast-but-unmined history row."
  },
  "walletActivityQueued": "Queued",
  "@walletActivityQueued": {
    "description": "Status of a send saved offline, waiting to broadcast."
  },
  "walletActivityRetrying": "Retrying",
  "@walletActivityRetrying": {
    "description": "Status of a wallet-created, unmined history row the wallet still OWES a broadcast (TxSummary.delivery == retryPending, stage S8 obligation): no endpoint has accepted it yet; the same signed bytes go out again on the next sync pass and after a relaunch. Replaces 'Pending' for that row in the activity list and the detail sheet."
  },
  "walletActivitySaved": "Saved",
  "@walletActivitySaved": {
    "description": "Status of a wallet-created, unmined history row whose signed bytes are kept but which the wallet is NOT broadcasting on its own right now (TxSummary.delivery == persisted — a swap deposit held past its quote's window). No promise of automatic sending."
  },
  "walletActivityExpired": "Expired",
  "@walletActivityExpired": {
    "description": "Status of an unmined transaction past its expiry — funds returned to spendable."
  },
  "walletActivityFailed": "Failed",
  "@walletActivityFailed": {
    "description": "Status of a transaction the endpoint rejected."
  },
  "walletActivityConfirmations": "{count, plural, =1{1 confirmation} other{{count} confirmations}}",
  "@walletActivityConfirmations": {
    "description": "Confirmation depth of a mined history row.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "walletPaymentReceived": "{count, plural, =1{Payment received} other{{count} payments received}}",
  "@walletPaymentReceived": {
    "description": "Transient arrival cue (SnackBar; also announced by screen readers) shown when the live incoming-funds stream reports new confirmed arrivals (maintainer decision — the minimal option). DELIBERATELY amount-free: the event payload carries no amount by design (ADR-0536); details are one tap away in the activity list.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "walletActivityRowHint": "Show transaction details",
  "@walletActivityRowHint": {
    "description": "Screen-reader tap hint on a history row (the row opens the transaction-detail sheet)."
  },
