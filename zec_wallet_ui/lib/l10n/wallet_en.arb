  "@walletTxDetailHeight": {
    "description": "Label of the mined-height row in the transaction-detail sheet (shown only when mined)."
  },
  "walletTxDetailMemo": "Memo",
  "@walletTxDetailMemo": {
    "description": "Label of the memo row in the transaction-detail sheet (shown only when the tx carries one)."
  },
  "walletTxDetailMemoAttached": "Included",
  "@walletTxDetailMemoAttached": {
    "description": "Value of the memo row: the tx carries an encrypted memo (content is not yet fetchable through the SDK, so only its presence is shown)."
  },
  "walletTxDetailTxid": "Transaction ID",
  "@walletTxDetailTxid": {
    "description": "Label of the transaction-id row in the transaction-detail sheet."
  },
  "walletTxDetailCopyTxid": "Copy transaction ID",
  "@walletTxDetailCopyTxid": {
    "description": "Button that copies the FULL transaction id (the row shows a shortened form)."
  },
  "walletTxDetailCopied": "Transaction ID copied",
  "@walletTxDetailCopied": {
    "description": "Snackbar confirmation after copying the transaction id."
  },
  "walletTxDetailClose": "Close",
  "@walletTxDetailClose": {
    "description": "Dismiss button of the transaction-detail sheet (sibling of walletShieldClose/walletMoveClose)."
  },
  "walletTxFundsKept": "No funds left your wallet",
  "@walletTxFundsKept": {
    "description": "Prominent reassurance for an expired/failed transaction: the money-honest core fact (TxStatus.expired ⇒ funds returned to spendable; failed ⇒ endpoint rejected, nothing spent). Used in the detail-sheet banner and appended to the history row's screen-reader label."
  },
  "walletTxExplainQueued": "Saved on this device, under Saved & pending — you can send it or cancel it there.",
  "@walletTxExplainQueued": {
    "description": "Plain-language explanation of the Queued status in the transaction-detail sheet. Never 'waiting for a connection' (a send can be queued while ONLINE via the not-synced-yet path, and a queued row can be viewed during a non-network stall). Names NO drain schedule at all (#401 R1): at host custody the background pass holds no signing credential, so it points at the surface and the two real actions instead — the walletSendQueuedBody wording family. LATENT today: history.rs maps Queued rows out of the chain view, so this arm is unreachable; it is kept true so it cannot go live wrong."
  },
  "walletTxExplainPending": "Sent to the Zcash network — waiting to be confirmed in a block.",
  "@walletTxExplainPending": {
    "description": "Plain-language explanation of the Pending status in the transaction-detail sheet (also the forward-compat Unknown arm, which renders as Pending). Shown for an unmined wallet-created row only once an endpoint ACCEPTED it (TxSummary.delivery accepted/null); a row the wallet is still retrying gets walletTxExplainRetrying instead, because 'sent to the network' is false for it."
  },
  "walletTxExplainRetrying": "Your wallet couldn't send this to the Zcash network yet. It keeps the signed transaction and tries again on each sync until it goes through or expires.",
  "@walletTxExplainRetrying": {
    "description": "Plain-language explanation for a wallet-created, unmined row the wallet still owes a broadcast (TxSummary.delivery == retryPending, stage S8 obligation). Cause-agnostic (a transport miss, a blackholed private path, a kill between signing and sending). 'On each sync' — never 'as soon as you're online' (the #399 reconnect-promptness rule). The expiry clause is true: a transaction past its expiry height is never rebroadcast and the funds free again."
  },
  "walletTxExplainSaved": "Your wallet has kept this signed transaction but isn't sending it by itself right now.",
  "@walletTxExplainSaved": {
    "description": "Plain-language explanation for a wallet-created, unmined row whose bytes are kept without a retry promise (TxSummary.delivery == persisted — a swap deposit held past its quote's window). Makes no claim about automatic sending either way."
  },
  "walletTxExplainConfirmed": "Confirmed on the Zcash network.",
  "@walletTxExplainConfirmed": {
    "description": "Plain-language explanation of the Confirmed status in the transaction-detail sheet (the depth rides the status row)."
  },
  "walletTxExplainExpired": "This transaction expired before the network confirmed it, so it was cancelled. The amount is still yours to spend.",
  "@walletTxExplainExpired": {
    "description": "Plain-language explanation of the Expired status: cancelled, nothing withdrawn (the maintainer's 'what does expired mean' ask). The banner (walletTxFundsKept) carries the headline reassurance; this adds the mechanism."
  },
  "walletTxExplainFailed": "The network rejected this transaction, so it didn't go through. The amount is still yours to spend.",
  "@walletTxExplainFailed": {
    "description": "Plain-language explanation of the Failed status: endpoint-rejected, nothing withdrawn."
  },
  "walletTxExplainUnknown": "This transaction's current status can't be determined. It will update after the next sync.",
  "@walletTxExplainUnknown": {
    "description": "Plain-language explanation of the forward-compat Unknown status: neutral — must never AFFIRM a broadcast (unlike walletTxExplainPending) nor claim cancellation, since the binding cannot interpret the state (security review)."
  },
  "walletMenuTooltip": "More options",
  "@walletMenuTooltip": {
    "description": "Tooltip / screen-reader label for the wallet app-bar overflow menu."
  },
  "walletRescanMenuItem": "Rescan history…",
  "@walletRescanMenuItem": {
    "description": "Wallet app-bar overflow-menu item that opens the rescan-recovery sheet."
  },
  "walletCheckOneTimeMenuItem": "Check one-time addresses…",
  "@walletCheckOneTimeMenuItem": {
    "description": "Wallet app-bar overflow-menu item that runs the manual one-time (ephemeral) address check/recovery — always available, covering returns the automatic windowed detect can no longer see (an old return past the detect window, or a re-used one-time address)."
  },
  "walletRescanTitle": "Rescan your history",
  "@walletRescanTitle": {
    "description": "Title of the rescan-recovery confirm sheet."
  },
  "walletRescanBody": "Missing older funds? Re-scan the blockchain from further back to recover deposits an earlier start date skipped. Your funds and recovery phrase are never at risk.",
  "@walletRescanBody": {
    "description": "Body of the rescan sheet: what rescan does + the money-safety reassurance."
  },
  "walletRescanRangeTitle": "How far back to scan",
  "@walletRescanRangeTitle": {
    "description": "Heading of the date-range control in the rescan sheet."
  },
  "walletRescanRangeAll": "Scan your whole history — slowest, but recovers everything.",
  "@walletRescanRangeAll": {
    "description": "Description shown when the rescan will scan the full history (no date)."
  },
  "walletRescanRangeDefault": "Scanning from your wallet's start. Restored this wallet and older funds are still missing? Pick an earlier date, or Scan all history.",
  "@walletRescanRangeDefault": {
    "description": "Description of the DEFAULT rescan range when it is the wallet's own birthday (a wallet younger than a year, where scanning earlier would only cover empty pre-wallet blocks). Does NOT claim completeness of the USER's funds — a too-high restore birthday can leave real deposits below this floor — so it points the recovery user at the earlier-date / scan-all escape hatch (the same nudge the chosen-date arm carries)."
  },
  "walletRescanRangeResolving": "Preparing the recommended range…",
  "@walletRescanRangeResolving": {
    "description": "Transient description while the wallet's scan-floor read is in flight (sub-millisecond normally; up to the FFI timeout on a wedged bridge). Pick-a-date and Scan-all stay available; only Start waits."
  },
  "walletRescanEstimate": "About {blocks} blocks to scan.",
  "@walletRescanEstimate": {
    "description": "Size cue under the rescan range control — the approximate number of blocks the chosen range covers, so the duration warning has a visible magnitude. Pre-formatted compact count (e.g. \"1.6M\").",
    "placeholders": {
      "blocks": {
        "type": "String",
        "example": "1.6M"
      }
    }
  },
  "walletRescanRangeChosen": "Scanning from {date} on. Still missing older funds? Pick an earlier date, or Scan all history.",
  "@walletRescanRangeChosen": {
    "description": "Description shown when a rescan start date is chosen.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "walletRescanPick": "Pick a date",
  "@walletRescanPick": {
    "description": "Button to choose a rescan start date."
  },
  "walletRescanChange": "Change date",
  "@walletRescanChange": {
    "description": "Button to change an already-chosen rescan start date."
  },
  "walletRescanScanAll": "Scan all history",
  "@walletRescanScanAll": {
    "description": "Button to clear the rescan start date and scan the full history."
  },
  "walletRescanDatePick": "Earliest date to scan",
  "@walletRescanDatePick": {
    "description": "Help text on the rescan date picker dialog."
  },
  "walletRescanWarning": "This re-scans the blockchain. Recent dates take minutes; scanning far back can take hours. Sync runs in the background — you can keep using your wallet.",
  "@walletRescanWarning": {
    "description": "Honest expectation-setting note in the rescan sheet — the duration scales with how far back the chosen date reaches (the ~1-year default measured hours on emulator-class hardware, so 'a few minutes' over-promised)."
  },
  "walletRescanSettlingAdvisory": "A payment from this wallet is still settling. The wallet usually declines to rescan until it completes — you can try, but expect it to be refused.",
  "@walletRescanSettlingAdvisory": {
    "description": "Rescan sheet advisory shown while in-flight sends exist (#364 M3): the engine's settling-send fence will likely refuse the rescan, and the refusal costs a full quiesce — say so BEFORE Start. Advisory only; the engine stays authoritative, so the copy must hedge ('usually', 'expect') and never promise refusal."
  },
  "walletRescanConfirm": "Start rescan",
  "@walletRescanConfirm": {
    "description": "Confirm button that starts the rescan."
  },
  "walletRescanCancel": "Cancel",
  "@walletRescanCancel": {
    "description": "Dismiss the rescan sheet without rescanning."
  },
  "walletRescanRunning": "Rebuilding…",
  "@walletRescanRunning": {
    "description": "Label while the rescan rebuild FFI call is in progress."
  },
  "walletRescanRebuildingAll": "Rebuilding your history — scanning your whole chain. Your balance and activity fill in as it catches up.",
  "@walletRescanRebuildingAll": {
    "description": "Activity-section cue while a full-history rescan repopulates."
  },
  "walletRescanRebuildingFrom": "Rebuilding your history from {date} — your balance and activity fill in as it catches up.",
  "@walletRescanRebuildingFrom": {
    "description": "Activity-section cue while a dated rescan repopulates.",
    "placeholders": {
      "date": {
        "type": "String"
      }
    }
  },
  "walletRescanRebuildingDefault": "Rebuilding your history from your wallet's start — your balance and activity fill in as it catches up.",
  "@walletRescanRebuildingDefault": {
    "description": "Activity-section cue while the default rescan (from the wallet's own birthday) repopulates."
  },
  "walletCatchUpBanner": "Catching up — your balance and activity fill in as the wallet syncs. Anything you've received is safe.",
  "@walletCatchUpBanner": {
    "description": "Top-of-wallet reassurance banner on the durable catch-up arm (#380): the wallet has never completed a sync pass and is below the chain tip — a relaunch mid-rescan catch-up, a dismissed rescan notice over a rebuilt wallet, or a restore/create's first sync. Generic: unlike the walletRescanRebuilding* family it cannot name what the user chose (the choice does not survive a relaunch). HEDGED funds claim (review, the #356-F7 precedent): a fresh create's first sync — possibly offline, so unbounded — shares this cue, and 'your funds are safe' would assert funds that provably don't exist; 'anything you've received' is conditionally true on every arm."
  },
  "walletCatchUpRescanBanner": "Rebuilding your history after a rescan — your balance and activity fill in as it catches up. Anything you've received is safe.",
  "@walletCatchUpRescanBanner": {
    "description": "Top-of-wallet reassurance banner on the durable rescan arm (#377 s357b-2): the core's rescan-rebuilding breadcrumb says a rescan rebuild is still catching up, but the in-session choice (which range) did not survive the relaunch — so the copy names the RESCAN (the user's own deliberate action, the stronger 'did I lose funds?' reassurance) without naming the range the walletRescanRebuilding* family can. Same HEDGED funds claim as walletCatchUpBanner ('anything you've received' — a zero-balance wallet rescans too)."
  },
  "walletRescanFailedNotice": "Couldn't rescan right now — your funds are safe, though your balance and history may need a little time to catch back up. Try again in a moment.",
  "@walletRescanFailedNotice": {
    "description": "Honest cue shown when a rescan failed but the wallet was recovered by re-opening. Claims funds-safety only, never 'unchanged' (#379): a fault AFTER the rebuild's atomic rename recovers into the REBUILT lower-birthday wallet, whose balance/history repopulate via the auto-restarted sync."
  },
  "walletRescanBlockedSettlingNotice": "A payment is still settling, so rescanning is paused to protect your funds. Your wallet is unchanged — try again in a couple of hours and keep the app open and online.",
  "@walletRescanBlockedSettlingNotice": {
    "description": "Cue shown when the SDK refused a rescan because a broadcast send has not settled yet (rebuilding under it could double-pay); resolution takes hours of online sync."
  },
  "walletRescanBlockedSyncNotRunningNotice": "Rescanning rebuilds your history as your wallet syncs, and syncing isn't running right now. Your wallet is unchanged — try again once syncing is running.",
  "@walletRescanBlockedSyncNotRunningNotice": {
    "description": "Rescan refusal notice (#405): the commit-point fence turned the confirm away because no sync pass will run (host policy off OR a failed sync start), so the wipe would strand a zeroed wallet behind a rebuild that cannot execute. Nothing destructive ran, which is why this is the one rescan refusal entitled to say 'your wallet is unchanged' outright (#379 softened walletRescanFailedNotice because a post-rename fault leaves a REBUILT wallet). CAUSE-AGNOSTIC — the badge and the start-failed notice above it carry the cause and the way out."
  },
  "walletRescanNeedsSpaceNotice": "There isn't enough free space to rebuild your wallet history — your funds are safe, though your balance and history may need a little time to catch back up. Free up some space and try again.",
  "@walletRescanNeedsSpaceNotice": {
    "description": "Cue shown when a rescan failed because the device is out of disk space; retrying without freeing space will fail again, so the copy asks for space instead of a retry. Claims funds-safety only, never 'unchanged' (#379): a DiskFull after the rebuild's atomic rename recovers into the REBUILT lower-birthday wallet."
  },
  "walletRescanFailedDismiss": "Dismiss",
  "@walletRescanFailedDismiss": {
    "description": "Dismiss the rescan-failed cue."
  },
  "walletActivityRebuilding": "Rebuilding your history…",
  "@walletActivityRebuilding": {
    "description": "Short activity-section cue shown in place of the empty card while a rescan repopulates."
  },
  "walletActivityCatchingUp": "Still catching up — anything you've received will show up here.",
  "@walletActivityCatchingUp": {
    "description": "Short activity-section cue shown in place of the empty card on the durable catch-up arm (#380) — the wallet is provably still filling in but the rescan choice is unknown (post-relaunch / post-dismiss / a restore's first sync). HEDGED (review): a fresh create's first sync shares this cue, so it must not assert a history that doesn't exist — 'anything you've received will show up here' is true on the rebuilt, restored, AND empty-new arms."
  },
  "walletActivitySyncNotRunning": "Your balance and history will finish loading once syncing is running.",
  "@walletActivitySyncNotRunning": {
    "description": "Activity-section note replacing 'No activity yet' when history exists but cannot repopulate because no sync pass will run (UX HIGH; #405 widened it from the host policy to the SSOT so a FAILED start is covered too). States the pending fill and its condition; CAUSE-AGNOSTIC — the badge above it names why sync isn't running."
  },
  "walletActivityLoadMore": "Load more",
  "@walletActivityLoadMore": {
    "description": "Button at the bottom of the activity list that fetches the next keyset page."
  },
  "walletPendingChangeLabel": "Pending change",
  "@walletPendingChangeLabel": {
    "description": "Label for our own change in flight (normal right after a send); shown so the breakdown reconciles to the total."
  },
  "walletTransparentLabel": "Unshielded (public)",
  "@walletTransparentLabel": {
    "description": "Label for the transparent (unshielded) portion of the balance — privacy-relevant, shown only when nonzero."
  },
  "walletTransparentNote": "Not included in \"Spendable now\" — shield these funds to spend them. Until then they stay publicly visible on-chain.",
  "@walletTransparentNote": {
    "description": "Honest note under a nonzero unshielded balance: BOTH the spendability truth (transparent funds count toward the total but not the spendable figure until shielded — the 'why is my total bigger than spendable' question must be answerable from the card itself, maintainer) AND the privacy truth (publicly visible until shielded)."
  },
  "walletTransparentNoteWatchOnly": "These funds are publicly visible on-chain.",
  "@walletTransparentNoteWatchOnly": {
    "description": "The transparent-funds note for a WATCH-ONLY wallet (#397 §3.7 D5): it keeps only the privacy truth (public on-chain) and drops the 'shield these to spend' framing, which a watch-only wallet cannot follow (no spending keys)."
  },
  "walletPoolShielded": "Shielded {amount}",
  "@walletPoolShielded": {
    "description": "Balance-card pool-clarity line (#389), private-pool segment: the shielded (private) portion of the total, shown always-on directly under the headline so 'how much of my ZEC is private?' is answerable at a glance. amount is a pre-formatted BARE ZEC figure (NO unit) — the unit rides the headline right above, and shielded + transparent sum EXACTLY to it (shielded = total − transparent), so the bare numbers can never disagree with the total. Keep it short: it shares ONE line with the transparent segment. 'Shielded' is the same privacy term used across the card; translate it as the sibling walletTransparentLabel does.",
    "placeholders": {
      "amount": {
        "type": "String"
      }
    }
  },
  "walletPoolTransparent": "Public {amount}",
  "@walletPoolTransparent": {
    "description": "Balance-card pool-clarity line (#389), public-pool segment: the transparent (unshielded, publicly-visible-on-chain) portion, rendered in the same privacy-orange the rest of the card uses for transparent funds. amount is pre-formatted BARE ZEC (unit on the headline). Keep it short (shares one line with the shielded segment). Match the 'transparent/unshielded' wording of the sibling walletTransparentLabel.",
    "placeholders": {
      "amount": {
        "type": "String"
      }
    }
  },
  "walletPoolAllShielded": "All shielded · private",
  "@walletPoolAllShielded": {
    "description": "Balance-card pool-clarity line (#389) when the transparent balance is zero: a positive affirmation that EVERY coin is in the shielded (private) pool. Always-on so an all-private wallet gets explicit reassurance, not merely the absence of a transparent line. The '·' (U+00B7 middot) separates the two clauses; keep a real middot with a space on each side. 'shielded' and 'private' as elsewhere on the card."
  },
  "walletPoolTapHint": "Show public funds",
  "@walletPoolTapHint": {
    "description": "Screen-reader tap hint (#389) for the balance-card pool line: read after the button role as 'double tap to <hint>'. Tapping the line opens the Transparent funds sheet. Imperative verb phrase, like walletSyncBadgeHint ('Show sync details')."
  },
  "walletRecoverableEphemeralNote": "{amount} of your balance is on a one-time address (recoverable).",
  "@walletRecoverableEphemeralNote": {
